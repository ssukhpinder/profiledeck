{
  "name": "profiledeck",
  "version": "0.1.0",
  "private": true,
  "description": "Profile-aware skill and connector routing for ChatGPT and Codex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssukhpinder/profiledeck.git"
  },
  "homepage": "https://github.com/ssukhpinder/profiledeck#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:plugin": "node scripts/build.mjs plugin",
    "build:http": "node scripts/build.mjs http",
    "dev:http": "tsx server/src/http.ts",
    "start:http": "node dist/profiledeck-http.mjs",
    "test": "node --import tsx --test server/test/policy.test.ts server/test/store.test.ts server/test/mcp-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "validate": "node scripts/validate-repo.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm licenses:check && pnpm validate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.1.0",
    "proper-lockfile": "4.1.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
